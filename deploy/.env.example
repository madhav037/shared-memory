# Copy to .env beside compose.yaml and fill in.

# The server's domain name. Its DNS A/AAAA record must point at this host, with ports 80 and 443 open.
SHARED_MEMORY_DOMAIN=memory.example.com

# Password for Postgres inside the stack. Never exposed outside it.
POSTGRES_PASSWORD=change-me

# Private git repository that receives the nightly backup (memory history on main, database dump on database).
BACKUP_REMOTE=git@github.com:your-org/shared-memory-backup.git
# SSH private key with write access to BACKUP_REMOTE (for GitHub, a deploy key with write access).
BACKUP_SSH_KEY=./backup_key
# When the nightly backup runs, in TZ.
BACKUP_TIME=02:00
TZ=UTC

# GitHub owner/repo of the plugin marketplace, shown in create_project's settings.
SHARED_MEMORY_PLUGIN_MARKETPLACE=madhav037/shared-memory

# The GitHub app members sign in to the console with. Leave empty to run without the console's sign-in.
# Register it at https://github.com/settings/developers with the callback URL
# https://<SHARED_MEMORY_DOMAIN>/api/sign-in/github/callback
SHARED_MEMORY_GITHUB_CLIENT_ID=
SHARED_MEMORY_GITHUB_CLIENT_SECRET=

# On a host whose own web server (nginx, say) already holds ports 80 and 443, uncomment both: Caddy then listens on
# 127.0.0.1:SHARED_MEMORY_LOCAL_PORT only, and the host's web server holds HTTPS and passes the domain to it.
# See docs/deployment.md, "Behind a web server the host already runs", and nginx-site.conf.example.
# COMPOSE_FILE=compose.yaml:behind-a-proxy.yaml
# SHARED_MEMORY_LOCAL_PORT=8180

# Server processes, and the Postgres connections they share (see docs/deployment.md, Sizing). Optional.
# SHARED_MEMORY_WORKERS=2
# SHARED_MEMORY_DATABASE_CONNECTIONS=40
