# nginx site for Shared Memory behind a web server the host already runs (behind-a-proxy.yaml).
# Replace memory.example.com with SHARED_MEMORY_DOMAIN and 8180 with SHARED_MEMORY_LOCAL_PORT, then:
#   sudo cp nginx-site.conf.example /etc/nginx/sites-available/shared-memory
#   sudo ln -s /etc/nginx/sites-available/shared-memory /etc/nginx/sites-enabled/shared-memory
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d memory.example.com
# certbot adds the HTTPS server block and the redirect from HTTP. It touches no other site.

server {
    listen 80;
    listen [::]:80;
    server_name memory.example.com;

    # The stack refuses a body over a megabyte itself; this keeps nginx from refusing smaller ones first.
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        # MCP answers can stream (server-sent events) and a session-start hook can take a few seconds.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
