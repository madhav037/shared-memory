# nginx site for Shared Memory behind a web server the host already runs (behind-a-proxy.yaml).
# Replace memory.example.com with SHARED_MEMORY_DOMAIN and 8180 with SHARED_MEMORY_LOCAL_PORT, then:
#   sudo cp nginx-site.conf.example /etc/nginx/sites-available/shared-memory
#   sudo ln -s /etc/nginx/sites-available/shared-memory /etc/nginx/sites-enabled/shared-memory
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d memory.example.com
# certbot adds the HTTPS server block and the redirect from HTTP. It touches no other site.

# Everything here goes on to the stack's Caddy, which counts each personal token, the hooks on every tool call and the
# console as the server does. nginx only turns away a flood from one address, above what a whole office's agents and
# consoles make: 15 members at the server's 120 calls a minute, 480 more for the hooks on every tool call, and 300 for
# the console. This goes in the http context, which is where sites-enabled files are included.
limit_req_zone $binary_remote_addr zone=shared_memory_address:10m rate=15000r/m;

server {
    listen 80;
    listen [::]:80;
    server_name memory.example.com;

    # The stack refuses a body over a megabyte itself; this keeps nginx from refusing smaller ones first.
    client_max_body_size 2m;

    # No security headers here: the stack's Caddy sends them (HSTS, CSP, nosniff, Referrer-Policy) and nginx passes
    # them on. Adding the same headers here would send them twice.
    # The uptime check is never limited, as the server never limits it.
    location = /health {
        proxy_pass http://127.0.0.1:8180;
        proxy_set_header Host $host;
    }

    location / {
        limit_req zone=shared_memory_address burst=3000 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The address nginx saw, alone: appending to the caller's own header would let them choose theirs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        # MCP answers can stream (server-sent events) and a session-start hook can take a few seconds.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
