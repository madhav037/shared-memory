# Caddy gets and renews the HTTPS certificate for the domain automatically, serves the console, and passes
# everything the server owns through to it. One domain, one certificate, one origin for the console's cookies.
#
# Behind a web server the host already runs (behind-a-proxy.yaml), that server holds HTTPS and the site address is a
# plain port; it is the only thing that can reach this one, so its X-Forwarded-* headers are believed and passed on.
{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# The edge's rate limit is coarse: it refuses floods before they wake a worker, with ceilings at or above the server's own
# (which count precisely, in Postgres). Calls carrying a personal token are counted per personal token, the rest per
# client address (as trusted_proxies resolves it). Console calls come from browsers, so /api is counted per address with
# room for a whole office. Set the ceilings in .env.
(agent_limits) {
	rate_limit {
		zone by_token {
			match {
				header Authorization Bearer*
			}
			key {http.request.header.Authorization}
			window 1m
			events {$CADDY_RATE_TOKEN_PER_MINUTE:240}
		}
		zone by_address {
			match {
				not header Authorization Bearer*
			}
			key {client_ip}
			window 1m
			events {$CADDY_RATE_ADDRESS_PER_MINUTE:60}
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	# No request the server is passed carries more than a megabyte: a hook is a prompt plus metadata, a memory is at
	# most 600 words, and a console request is smaller still. A bigger body is refused here, before the server sees it.
	request_body {
		max_size 1MB
	}

	# A team's server is kept out of search engines; whoever runs the server where the landing page should be found
	# sets SHARED_MEMORY_ROBOTS_TAG=all.
	header X-Robots-Tag {$CADDY_ROBOTS_TAG:noindex}

	# What every answer tells the browser. The console holds a signed-in cookie, so it must not be framed (clickjacking
	# on pin, retire and challenge decisions) and it must load only from its own origin: its bundle is one same-origin
	# module, its fonts are files it ships, its data comes from /api. Mantine injects style tags and style attributes,
	# which is why style-src allows 'unsafe-inline'; scripts get no such allowance. Behind a web server the host already
	# runs, these pass through it unchanged, so the nginx site needs none of its own.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		rate_limit {
			zone console_by_address {
				key {client_ip}
				window 1m
				events {$CADDY_RATE_CONSOLE_PER_MINUTE:1200}
			}
		}
		reverse_proxy server:8000
	}

	handle /mcp* {
		import agent_limits
		reverse_proxy server:8000
	}

	handle /hooks/* {
		import agent_limits
		reverse_proxy server:8000
	}

	# The console is a single-page app: any address it owns is served by its own page. Only the console is compressed;
	# the server's answers above stream, and compressing them would hold them back. Its assets carry a hash in their
	# names, so they are cached for good; its page is asked for afresh, so a release reaches browsers at once.
	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		@page not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
