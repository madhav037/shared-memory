# Caddy gets and renews the HTTPS certificate for the domain automatically, serves the console, and passes
# everything the server owns through to it. One domain, one certificate, one origin for the console's cookies.
#
# Behind a web server the host already runs (behind-a-proxy.yaml), that server holds HTTPS and the site address is a
# plain port; it is the only thing that can reach this one, so its X-Forwarded-* headers are believed and passed on.
{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$CADDY_SITE_ADDRESS} {
	# No request the server is passed carries more than a megabyte: a hook is a prompt plus metadata, a memory is at
	# most 600 words, and a console request is smaller still. A bigger body is refused here, before the server sees it.
	request_body {
		max_size 1MB
	}

	# A team's server is kept out of search engines; whoever runs the server where the landing page should be found
	# sets SHARED_MEMORY_ROBOTS_TAG=all.
	header X-Robots-Tag {$CADDY_ROBOTS_TAG:noindex}

	handle /api/* {
		reverse_proxy server:8000
	}

	handle /mcp* {
		reverse_proxy server:8000
	}

	handle /hooks/* {
		reverse_proxy server:8000
	}

	# The console is a single-page app: any address it owns is served by its own page. Only the console is compressed;
	# the server's answers above stream, and compressing them would hold them back. Its assets carry a hash in their
	# names, so they are cached for good; its page is asked for afresh, so a release reaches browsers at once.
	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		@page not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
