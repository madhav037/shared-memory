# Caddy gets and renews the HTTPS certificate for the domain automatically, serves the console, and passes
# everything the server owns through to it. One domain, one certificate, one origin for the console's cookies.
#
# Behind a web server the host already runs (behind-a-proxy.yaml), that server holds HTTPS and the site address is a
# plain port; it is the only thing that can reach this one, so its X-Forwarded-* headers are believed and passed on.
# Strict: the client is the right-most address in X-Forwarded-For that isn't a trusted proxy, so whatever a caller
# writes in that header themselves, to the left, is never taken for their address.
{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# The one way to the server. The server counts calls per address by X-Forwarded-For, so it is handed one address, the
# client as found above, and never the header the caller sent.
(to_server) {
	reverse_proxy server:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The edge's rate limit is coarse: it refuses floods before they wake a worker, with ceilings at or above the server's own
# (which count precisely, in Postgres). Calls carrying a personal token are counted per personal token, the rest per
# client address (as trusted_proxies resolves it). A made-up token would be a fresh allowance on every call, so calls
# carrying a token are counted per address too, with room for a whole office. The hooks on every tool call have their
# own allowance, as the server gives them (TOOL_HOOK_PATHS in ratelimit.py): an edit whose hook is refused here goes
# ahead unchecked. Console calls come from browsers, so /api is counted per address with room for a whole office. Set
# the ceilings in .env.
(agent_limits) {
	rate_limit {
		zone by_token {
			match {
				header Authorization Bearer*
				not path /hooks/before-edit /hooks/after-tool /hooks/standby
			}
			key {http.request.header.Authorization}
			window 1m
			events {$CADDY_RATE_TOKEN_PER_MINUTE:240}
		}
		zone token_by_address {
			match {
				header Authorization Bearer*
				not path /hooks/before-edit /hooks/after-tool /hooks/standby
			}
			key {client_ip}
			window 1m
			events {$CADDY_RATE_TOKEN_ADDRESS_PER_MINUTE:2400}
		}
		zone tool_hooks_by_token {
			match {
				header Authorization Bearer*
				path /hooks/before-edit /hooks/after-tool /hooks/standby
			}
			key {http.request.header.Authorization}
			window 1m
			events {$CADDY_RATE_TOOL_HOOK_PER_MINUTE:960}
		}
		zone tool_hooks_by_address {
			match {
				header Authorization Bearer*
				path /hooks/before-edit /hooks/after-tool /hooks/standby
			}
			key {client_ip}
			window 1m
			events {$CADDY_RATE_TOOL_HOOK_ADDRESS_PER_MINUTE:9600}
		}
		zone by_address {
			match {
				not header Authorization Bearer*
			}
			key {client_ip}
			window 1m
			events {$CADDY_RATE_ADDRESS_PER_MINUTE:60}
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	# No request the server is passed carries more than a megabyte: a hook is a prompt plus metadata, a memory is at
	# most 600 words, and a console request is smaller still. A bigger body is refused here, before the server sees it.
	request_body {
		max_size 1MB
	}

	# A company's server is kept out of search engines: the landing page lives on the platform. Whoever wants a server
	# indexed anyway sets SHARED_MEMORY_ROBOTS_TAG=all.
	header X-Robots-Tag {$CADDY_ROBOTS_TAG:noindex}

	# What every answer tells the browser. The console holds a signed-in cookie, so it must not be framed (clickjacking
	# on pin, retire and challenge decisions) and it must load only from its own origin: its bundle is one same-origin
	# module, its fonts are files it ships, its data comes from /api. Mantine injects style tags and style attributes,
	# which is why style-src allows 'unsafe-inline'; scripts get no such allowance. Behind a web server the host already
	# runs, these pass through it unchanged, so the nginx site needs none of its own.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		rate_limit {
			zone console_by_address {
				key {client_ip}
				window 1m
				events {$CADDY_RATE_CONSOLE_PER_MINUTE:1200}
			}
		}
		import to_server
	}

	# The uptime check: the server answers JSON when it can reach Postgres. Proxied before the single-page fallback, or
	# it would answer 200 with the console's page while the server is dead. Never limited, as the server never limits it.
	handle /health {
		import to_server
	}

	handle /mcp* {
		import agent_limits
		import to_server
	}

	handle /hooks/* {
		import agent_limits
		import to_server
	}

	# The console is a single-page app: any address it owns is served by its own page. Only the console is compressed;
	# the server's answers above stream, and compressing them would hold them back. Its assets carry a hash in their
	# names, so they are cached for good; its page is asked for afresh, so a release reaches browsers at once.
	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		@page not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
