{
  "openapi": "3.1.0",
  "info": {
    "title": "Shared Memory console API",
    "version": "1"
  },
  "paths": {
    "/api/status": {
      "get": {
        "operationId": "status",
        "summary": "Whether the console has reached the server, and who it is signed in as.",
        "responses": {
          "200": {
            "description": "Whether the console has reached the server, and who it is signed in as.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/sign-in/github": {
      "get": {
        "operationId": "sign_in",
        "summary": "Begin signing in: send the member to GitHub.",
        "responses": {
          "302": {
            "description": "Begin signing in: send the member to GitHub."
          }
        }
      }
    },
    "/api/sign-in/github/callback": {
      "get": {
        "operationId": "sign_in_callback",
        "summary": "Finish signing in and return the member to the console.",
        "responses": {
          "302": {
            "description": "Finish signing in and return the member to the console."
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "projects",
        "summary": "The projects this member can reach.",
        "responses": {
          "200": {
            "description": "The projects this member can reach.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Projects"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/tree": {
      "get": {
        "operationId": "tree",
        "summary": "A project's memory as a folder tree, with each memory's title and summary.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A project's memory as a folder tree, with each memory's title and summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tree"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/memory": {
      "get": {
        "operationId": "memory",
        "summary": "One memory in full, with any challenges on it.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One memory in full, with any challenges on it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/search": {
      "get": {
        "operationId": "search",
        "summary": "Memories that match, by meaning and by exact words.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Memories that match, by meaning and by exact words.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "operationId": "audit",
        "summary": "The team's audit log, newest first.",
        "responses": {
          "200": {
            "description": "The team's audit log, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/memory/history": {
      "get": {
        "operationId": "history",
        "summary": "Every version of one memory, newest first.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every version of one memory, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryHistory"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/memory/version": {
      "get": {
        "operationId": "version",
        "summary": "A memory as it was at one version.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A memory as it was at one version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryAtVersion"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/memory/difference": {
      "get": {
        "operationId": "difference",
        "summary": "What changed in a memory between two versions.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What changed in a memory between two versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDifference"
                }
              }
            }
          }
        }
      }
    },
    "/api/members": {
      "get": {
        "operationId": "members",
        "summary": "Everyone in the team, with their role and GitHub account.",
        "responses": {
          "200": {
            "description": "Everyone in the team, with their role and GitHub account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "add_member",
        "summary": "Add a member and issue their first personal token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMember"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Add a member and issue their first personal token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{employee_id}/remove": {
      "post": {
        "operationId": "remove_member",
        "summary": "Remove a member: their sessions end and their personal token stops working.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Remove a member: their sessions end and their personal token stops working.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{employee_id}/change": {
      "post": {
        "operationId": "change_member",
        "summary": "Correct a member's name or the GitHub account they sign in with.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangedMember"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correct a member's name or the GitHub account they sign in with.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{employee_id}/admin": {
      "post": {
        "operationId": "set_admin",
        "summary": "Grant admin to a member, or take it away.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grant admin to a member, or take it away.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{employee_id}/ownership": {
      "post": {
        "operationId": "hand_over_ownership",
        "summary": "Make another member the team's owner.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Make another member the team's owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          }
        }
      }
    },
    "/api/my-token": {
      "post": {
        "operationId": "reissue_my_token",
        "summary": "Issue a new personal token for the signed-in member, revoking the one they had.",
        "responses": {
          "200": {
            "description": "Issue a new personal token for the signed-in member, revoking the one they had.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{employee_id}/token": {
      "post": {
        "operationId": "reissue_token",
        "summary": "Issue a new personal token for a member of the team, revoking the one they had.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issue a new personal token for a member of the team, revoking the one they had.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/sign-out": {
      "post": {
        "operationId": "sign_out",
        "summary": "End this console session.",
        "responses": {
          "200": {
            "description": "End this console session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignedInMember": {
        "description": "Who the console is signed in as.",
        "properties": {
          "employee_id": {
            "title": "Employee Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "team": {
            "title": "Team",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "employee_id",
          "name",
          "team",
          "role"
        ],
        "title": "SignedInMember",
        "type": "object"
      },
      "Status": {
        "description": "Whether the console has reached the server, and who it is signed in as.",
        "properties": {
          "signed_in": {
            "title": "Signed In",
            "type": "boolean"
          },
          "github_sign_in": {
            "title": "Github Sign In",
            "type": "boolean"
          },
          "member": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SignedInMember"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "signed_in",
          "github_sign_in",
          "member"
        ],
        "title": "Status",
        "type": "object"
      },
      "ProjectSummary": {
        "description": "A project the member can reach.",
        "properties": {
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "name"
        ],
        "title": "ProjectSummary",
        "type": "object"
      },
      "Projects": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "Projects",
        "type": "object"
      },
      "PendingChallenge": {
        "description": "A challenge this personal memory is waiting on.",
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "replaces": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replaces"
          }
        },
        "required": [
          "challenge_id",
          "kind",
          "replaces"
        ],
        "title": "PendingChallenge",
        "type": "object"
      },
      "TreeFolder": {
        "properties": {
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "memories": {
            "items": {
              "$ref": "#/components/schemas/TreeMemory"
            },
            "title": "Memories",
            "type": "array"
          }
        },
        "required": [
          "folder",
          "memories"
        ],
        "title": "TreeFolder",
        "type": "object"
      },
      "TreeMemory": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/PendingChallenge"
            },
            "title": "Pending",
            "type": "array"
          }
        },
        "required": [
          "path",
          "title",
          "summary",
          "pending"
        ],
        "title": "TreeMemory",
        "type": "object"
      },
      "Tree": {
        "description": "A project's memory, folder by folder.",
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/TreeFolder"
            },
            "title": "Folders",
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "title": "Tree",
        "type": "object"
      },
      "OpenChallenge": {
        "description": "A challenge raised against this memory.",
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "raised_by": {
            "title": "Raised By",
            "type": "string"
          },
          "challenger_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenger Path"
          }
        },
        "required": [
          "challenge_id",
          "kind",
          "raised_by",
          "challenger_path"
        ],
        "title": "OpenChallenge",
        "type": "object"
      },
      "MemoryDetail": {
        "description": "One memory in full, as its author wrote it.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "replaces": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replaces"
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By"
          },
          "exception_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception To"
          },
          "related_files": {
            "items": {
              "type": "string"
            },
            "title": "Related Files",
            "type": "array"
          },
          "promoted_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promoted By"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/PendingChallenge"
            },
            "title": "Pending",
            "type": "array"
          },
          "open_challenges": {
            "items": {
              "$ref": "#/components/schemas/OpenChallenge"
            },
            "title": "Open Challenges",
            "type": "array"
          }
        },
        "required": [
          "path",
          "level",
          "project_id",
          "title",
          "summary",
          "type",
          "author",
          "status",
          "replaces",
          "superseded_by",
          "exception_to",
          "related_files",
          "promoted_by",
          "body",
          "pending",
          "open_challenges"
        ],
        "title": "MemoryDetail",
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "heading": {
            "title": "Heading",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/PendingChallenge"
            },
            "title": "Pending",
            "type": "array"
          }
        },
        "required": [
          "path",
          "title",
          "heading",
          "level",
          "type",
          "author",
          "summary",
          "label",
          "pending"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchResults": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "SearchResults",
        "type": "object"
      },
      "AuditEvent": {
        "description": "One thing that happened, and who did it.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          }
        },
        "required": [
          "id",
          "at",
          "actor",
          "kind",
          "project_id",
          "target",
          "detail"
        ],
        "title": "AuditEvent",
        "type": "object"
      },
