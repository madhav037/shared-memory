{
  "name": "shared-memory-console",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript openapi.json -o src/api/schema.generated.check.d.ts && node scripts/check-types-match.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource/charis-sil": "^5.3.0",
    "@fontsource/cooper-hewitt": "^5.3.0",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.6.1",
    "@tabler/icons-react": "^3.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.9.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
